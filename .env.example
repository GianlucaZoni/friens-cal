# --- Supabase -----------------------------------------------------------
# Both of these are PUBLIC. They ship inside the browser bundle and anyone
# can read them. That is fine and intended: the protection is Row Level
# Security plus table grants, not secrecy. See docs/adr/0001.
#
# NEVER put the service_role key in here, or anywhere in this repo. That one
# bypasses RLS entirely.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Verification scripts only ------------------------------------------
# A real Friend, created from the Supabase dashboard — there is no signup
# until issue 14. Read by scripts/verify-friend-row.mjs, never by the app.
FRIEND_TEST_EMAIL=
FRIEND_TEST_PASSWORD=

# Optional. The setup flow that writes display_name is issue 03, so until then
# this is how a Friend gets a name for the authenticated route to render.
FRIEND_DISPLAY_NAME=
