# --- Supabase -----------------------------------------------------------
# Both of these are PUBLIC. They ship inside the browser bundle and anyone
# can read them. That is fine and intended: the protection is Row Level
# Security plus table grants, not secrecy. See docs/adr/0001.
#
# NEVER put the service_role key in here, or anywhere in this repo. That one
# bypasses RLS entirely.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Provisioning smoke test only ---------------------------------------
# Read by scripts/verify-supabase.mjs, never by the app. Delete once the
# provisioning ticket is closed.
SMOKE_TEST_EMAIL=
SMOKE_TEST_PASSWORD=
